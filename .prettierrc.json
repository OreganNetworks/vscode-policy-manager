{
  "printWidth": 120,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": ["**.json", "**.jsonl"],
      "options": { "parser": "json", "trailingComma": "none" }
    },
    {
      "files": ["**.jsonc"],
      "options": { "parser": "jsonc", "trailingComma": "none" }
    }
  ]
}
